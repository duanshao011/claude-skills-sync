# 在此处填入你的 DeepSeek API Key（AI 摘要功能使用）
# 获取地址：https://platform.deepseek.com/api_keys
# 不配置也可以正常使用阅读器和原文功能，仅 AI 摘要不可用
DEEPSEEK_API_KEY=sk-your-deepseek-key

# DeepSeek API 地址与模型（官方默认即可）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 国内渠道数据源（公众号/抖音/小红书/B站）RedFox API Key
REDFOX_API_KEY=ak-your-redfox-key
